formulas:
  Room: note.storage.room
  Level: note.storage.shelf.level
views:
  - type: table
    name: By room
    filters:
      and:
        - fileClass == "Comic"
    sort:
      - property: formula.Room
        direction: ASC
      - property: formula.Level
        direction: ASC
    order:
      - file.name
      - storage
      - formula.Room
      - formula.Level
      - series
  - type: fileclass-table
    name: Comic by contributors
    filters:
      and:
        - fileClass.containsAny("Comic")
        - contributors.contains(this.file.asLink())
    order:
      - file.name
      - series
      - pages
      - storage
